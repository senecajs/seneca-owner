{
  "name": "@seneca/owner",
  "version": "6.2.0",
  "description": "Seneca plugin to add user ownership annotations to entities.",
  "main": "dist/Owner.js",
  "type": "commonjs",
  "types": "dist/Owner.d.ts",
  "scripts": {
    "prettier": "prettier --write .",
    "test": "node --enable-source-maps --test \"test/**/*.test.js\"",
    "test-some": "node --enable-source-maps --test-name-pattern=\"$TEST_PATTERN\" --test \"test/**/*.test.js\"",
    "test-watch": "node --enable-source-maps --test --watch \"test/**/*.test.js\"",
    "watch": "tsc -w -d",
    "build": "tsc -d",
    "doc": "seneca-doc",
    "clean": "rm -rf node_modules yarn.lock package-lock.json dist",
    "reset": "npm run clean && npm i && npm run build && npm test",
    "repo-tag": "REPO_VERSION=`node -e \"console.log(require('./package').version)\"` && echo TAG: v$REPO_VERSION && git commit -a -m v$REPO_VERSION && git push && git tag v$REPO_VERSION && git push --tags;",
    "repo-publish": "npm run clean && npm i && npm run repo-publish-quick",
    "repo-publish-quick": "npm run build && npm run test && npm run doc && npm run repo-tag && npm publish --access public --registry https://registry.npmjs.org "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senecajs/seneca-owner.git"
  },
  "engines": {
    "node": ">=24"
  },
  "author": "Richard Rodger (richardrodger.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/senecajs/seneca-owner/issues"
  },
  "homepage": "https://github.com/senecajs/seneca-owner#readme",
  "files": [
    "LICENSE",
    "README.md",
    "src",
    "dist"
  ],
  "devDependencies": {
    "@hapi/code": "^9.0.3",
    "seneca-doc": "^2.1.3",
    "@types/hapi__joi": "^17.1.14",
    "@types/node": "^20.14.2",
    "lab-transform-typescript": "^3.0.1",
    "prettier": "^3.3.1",
    "seneca": "^3.33.0",
    "seneca-entity": "^25.1.1",
    "seneca-plugin-validator": "^0.6.1",
    "seneca-promisify": "^3.7.1",
    "shape": "^10.1.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "seneca": ">=3||>=4.0.0-rc2",
    "seneca-entity": ">=26",
    "seneca-promisify": ">=3",
    "shape": ">=10"
  }
}